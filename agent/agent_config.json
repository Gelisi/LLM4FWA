{
  "max_turns": 60,
  "command_timeout_s": 1800,
  "tool_output_max_chars": 6000,
  "temperature": 0.3,
  "max_tokens": 4096,
  "bash_allow_prefixes": [
    "python3 experiments/",
    "python3 -c",
    "python3 -m",
    "python3 fwarl/",
    "python3 agent/check_api.py",
    "python3 agent/sync_github.py",
    "ls",
    "cat",
    "head",
    "tail",
    "grep",
    "find",
    "wc",
    "diff",
    "sed -n",
    "make",
    "g++",
    "gcc",
    "cmake",
    "mkdir",
    "cp -r iterations/_TEMPLATE",
    "cp -r iterations/_template",
    "git status",
    "git diff",
    "git log",
    "git add",
    "git commit",
    "git init",
    "nvidia-smi",
    "free -h",
    "nproc"
  ],
  "bash_deny_patterns": [
    "rm -rf /",
    "rm -rf ~",
    "sudo",
    "git push",
    "git reset --hard",
    "git checkout .",
    "mkfs",
    "shutdown",
    "reboot",
    "> /dev/sd",
    "chmod -R 777 /",
    "pip install",
    "conda install",
    "curl",
    "wget",
    "ssh ",
    "scp "
  ],
  "workspace_root": null,
  "session_log_dir": "agent/sessions",
  "token_ledger": "agent/token_usage.jsonl"
}
