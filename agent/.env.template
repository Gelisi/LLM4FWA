# ============ autoresearch agent LLM 配置 ============
# 复制为 agent/.env 并填入真实值。两种适配器二选一（由 AGENT_LLM_KIND 决定）。

# ---- 方式 A：OpenAI 兼容接口（推荐：openai/azure/aihubmix/deepseek/本地 vLLM 等）----
AGENT_LLM_KIND=openai
AGENT_API_KEY=sk-xxxx
AGENT_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL=deepseek-chat

# ---- 方式 B：内网 iChat（HMAC 签名）----
# AGENT_LLM_KIND=ichat
# AGENT_API_KEY=<APPKEY>
# AGENT_APP_ID=<APPID>
# AGENT_SOURCE=<SOURCE>
# AGENT_BASE_URL=http://ichat.woa.com/api/chat_completions
# AGENT_MODEL=gpt-4o

# 网络模式：auto=直连失败后代理；direct=仅直连；proxy=仅代理。
# 强制代理时必须填写远端机器可访问的真实代理地址，不能照抄占位符。
AGENT_NETWORK_MODE=auto
# AGENT_PROXY=http://<代理主机>:<端口>
# AGENT_PROXY=$https_proxy
AGENT_CONNECT_TIMEOUT_S=10
AGENT_LLM_TIMEOUT_S=300
